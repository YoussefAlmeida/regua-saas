# ============================================================
# RÉGUA — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite .env.local — ele já está no .gitignore
# ============================================================

# Supabase — copie do dashboard: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role — NUNCA exposto no cliente, só server-side
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT secret para tokens customizados — Settings > API > JWT Secret
SUPABASE_JWT_SECRET=sua-chave-jwt-de-pelo-menos-32-caracteres

# Pepper para hash de senha (argon2id) — gere com: openssl rand -hex 32
# JAMAIS salve no banco. Perder esse valor = perder todos os logins.
PASSWORD_PEPPER=string-aleatoria-de-64-chars-nunca-no-banco

# WhatsApp Cloud API — configurar no Dia 5
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Asaas — configurar no Dia 5
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=

# Monitoramento (free tier, configurar no Dia 6)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
