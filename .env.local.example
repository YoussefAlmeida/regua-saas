# ============================================================
# RÉGUA — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite .env.local — ele já está no .gitignore
# ============================================================

# Supabase — copie do dashboard: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role — NUNCA exposto no cliente, só server-side
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT secret para tokens customizados — Settings > API > JWT Secret
SUPABASE_JWT_SECRET=sua-chave-jwt-de-pelo-menos-32-caracteres

# Pepper para hash de senha (argon2id) — gere com: openssl rand -hex 32
# JAMAIS salve no banco. Perder esse valor = perder todos os logins.
PASSWORD_PEPPER=string-aleatoria-de-64-chars-nunca-no-banco

# WhatsApp Cloud API — Meta for Developers > seu app > WhatsApp > API Setup
WHATSAPP_TOKEN=EAAxxxxxxxx
WHATSAPP_PHONE_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=string-aleatoria-para-verificacao-webhook

# Asaas — Minha Conta > Integrações > API Key
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=string-aleatoria-configurada-no-asaas

# Cron secret — protege /api/cron/* — gere com: openssl rand -hex 32
CRON_SECRET=string-aleatoria-de-64-chars

# Admin panel — /admin — gere com: openssl rand -hex 16
ADMIN_TOKEN=senha-do-painel-admin
