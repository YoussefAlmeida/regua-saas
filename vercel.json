{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/lembrete-cliente",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/diario",
      "schedule": "0 9 * * *"
    }
  ]
}
